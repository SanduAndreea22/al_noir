# Copy to .env and fill in real values. .env is gitignored and loaded automatically.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Neon connection string, e.g. postgresql://user:password@host/dbname?sslmode=require
# Leave empty to use local SQLite.
DATABASE_URL=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@alnoir.ro

# Cloudinary (media storage). Leave empty to store uploads on local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auto-creates an admin account on deploy if it doesn't exist yet (no Shell needed).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
